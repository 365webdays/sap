# Cron scripts are invoked by the cPanel cron scheduler via PHP CLI, never
# over HTTP. Block direct web access so nobody can trigger a send by visiting
# /api/cron/hour_reminder.php in a browser.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
