# App
APP_ENV=staging
APP_BASE_URL=https://staging.stanthonyadoration.com

# Database
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# JWT — must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# SMTP (PHPMailer)
# On GoDaddy cPanel hosting, create the mailbox under Email Accounts first.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. 587 is preferred.
SMTP_HOST=smtpout.secureserver.net
SMTP_USER=noreply@stanthonyadoration.com
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@stanthonyadoration.com
SMTP_FROM_NAME=St. Anthony Adoration

# Set to any non-empty value to log the full SMTP conversation to the PHP
# error log. Leave blank outside of debugging.
SMTP_DEBUG=
